# Local SQLite for development (Switch to Turso libsql:// URL for Vercel deployment)
DATABASE_URL="file:./scriptoria.db"
# TURSO_DATABASE_URL="libsql://your-db-name.turso.io"
# TURSO_AUTH_TOKEN="your-turso-auth-token"

# Master AES-256-GCM Vault Key (32-byte / 64-hex chars)
ENCRYPTION_KEY="replace-with-64-hex-char-secret"

# JWT Signing Secret for user sessions & VM heartbeat registration tokens
JWT_SECRET="replace-with-64-hex-char-jwt-secret"

# Mode Switch: Keep "false" for personal use; set "true" when launching to public
ALLOW_PUBLIC_REGISTRATION="false"

# Public URL where Kaggle/Colab VMs can reach /api/vm/heartbeat (e.g. https://scriptoria.krhimanshu.in)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Default Google Drive Base Folder ("NovelVisualizer/ComfyUI_Storage" or "Scriptoria")
GDRIVE_BASE_FOLDER="NovelVisualizer/ComfyUI_Storage"
