datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         String   @default("USER") // ADMIN, USER
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  credentials       Credential[]
  vmInstances       VmInstance[]
  jobs              Job[]
  systemLogs        SystemLog[]
  modelAssets       ModelAsset[]
  workflowTemplates WorkflowTemplate[]
  workspaceSettings WorkspaceSettings?
  agentSessions     AgentSession[]
  apiTokens         ApiToken[]
  batchJobs         BatchJob[]
  projects          Project[]
}

model Credential {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     String   // "kaggle", "colab", "cloudflare", "gdrive"
  accountAlias String   // e.g., "acc1", "acc2", "default"
  username     String?  // Kaggle username, Google email, etc.
  encryptedKey String   // AES-256-GCM ciphertext
  iv           String   // Hex initialization vector
  authTag      String   // Hex authentication tag
  authType     String   // "bearer" (KGAT_), "basic", "oauth_json"
  metadataJson String?  // Non-secret settings e.g. {"baseFolder": "Scriptoria"}
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, provider, accountAlias])
  @@index([userId])
}

model VmInstance {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  target        String    // "gpu0", "gpu1", "gpu2", "gpu3", "gcgpu", "gcgpu1"
  displayName   String    @default("")
  provider      String    // "kaggle", "colab"
  accountAlias  String    // Bound to Credential.accountAlias ("acc1", "acc2")
  sessionGroup       String    // Shared VM container group e.g. "kaggle-acc1", "kaggle-acc2", "colab-acc1"
  workerProfile      String    @default("BASE_COMFY") // BASE_COMFY, IMAGE_CORE, IMAGE_GGUF_EDIT, AUDIO_LIPSYNC, VIDEO_MOTION
  idleTimeoutMinutes Int?      // Optional per-slot override; null falls back to WorkspaceSettings.idleTimeoutMinutes
  prewarmModelsJson  String?   // Optional JSON array [{ category, filename }] to pre-stream while ComfyUI boots
  internalPort       Int       @default(8188) // 8188 or 8189 inside VM
  publicUrl     String    @default("")   // Live trycloudflare.com URL (Caddy :8000) or named tunnel
  vmSecret      String?   // Per-session X-VM-Secret verified by Caddy
  useRouteLess  Boolean   @default(true) // True: Caddy + X-Target-Port; False: legacy direct tunnel
  status        String    @default("OFFLINE") // OFFLINE, STARTING, ONLINE, BUSY, STOPPING, ERROR
  stepProgress  Int       @default(0) // 0: Idle, 1: Triggered, 2: Env/Rclone, 3: ComfyUI, 4: Tunnel, 5: Ready
  lastHeartbeat DateTime?
  onlineSince   DateTime?
  latencyMs     Int?
  vramTotalGb   Float?
  vramUsedGb    Float?
  gpuName       String?
  lastError     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  jobs       Job[]
  systemLogs SystemLog[]

  @@unique([userId, target])
  @@index([userId, status])
  @@index([userId, sessionGroup])
}

model Job {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  vmInstanceId    String?
  vmInstance      VmInstance? @relation(fields: [vmInstanceId], references: [id], onDelete: SetNull)
  target          String
  promptId        String?     // ComfyUI prompt_id for async polling
  prompt          String
  negativePrompt  String?
  checkpoint      String
  width           Int         @default(1024)
  height          Int         @default(1024)
  steps           Int         @default(25)
  cfg             Float       @default(6.0)
  seed            String?
  status          String      @default("PENDING") // PENDING, PROCESSING, SYNCING, COMPLETED, FAILED
  outputFiles     String?     // JSON array: [{ filename, gdriveFileId, gdrivePath, previewUrl }]
  errorMessage    String?
  executionTimeMs Int?
  createdAt       DateTime    @default(now())
  completedAt     DateTime?

  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([vmInstanceId])
}

model SystemLog {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  vmInstanceId String?
  vmInstance   VmInstance? @relation(fields: [vmInstanceId], references: [id], onDelete: Cascade)
  category     String      @default("SYSTEM") // SYSTEM, ACTION, KAGGLE, COLAB, RCLONE, COMFYUI, HEALTH, NETWORK, ERROR
  level        String      @default("INFO") // INFO, WARN, ERROR, SUCCESS, DEBUG
  message      String
  metaJson     String?
  createdAt    DateTime    @default(now())

  @@index([userId, createdAt])
}

model ModelAsset {
  id                      String    @id @default(cuid())
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug                    String
  displayName             String
  modality                String    // "IMAGE" | "AUDIO" | "VIDEO" | "SHARED"
  category                String    // checkpoints, unet, text_encoders, clip, vae, loras, controlnet, ipadapter, clip_vision, upscale_models, ultralytics, sams, tts, audio_sfx, audio_bgm, lipsync
  subdir                  String    @default("")
  filename                String
  sizeBytes               Float?
  vramEstimateGb          Float     @default(0)
  compatibleBase          String    @default("SDXL")
  requiredCustomNodesJson String?
  recommendedConfigJson   String?
  hfRepoId                String?
  hfFilePath              String?
  civitaiModelId          String?
  civitaiVersionId        String?
  directUrl               String?
  sha256                  String?
  gdrivePath              String?
  gdriveFileId            String?
  backupStatus            String    @default("NONE") // NONE, BACKING_UP, BACKED_UP, FAILED
  isSeeded                Boolean   @default(false)
  lastVerifiedAt          DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@unique([userId, slug])
  @@index([userId, modality, category])
}

model WorkflowTemplate {
  id                   String   @id @default(cuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug                 String
  name                 String
  modality             String   // "IMAGE" | "AUDIO" | "VIDEO" | "MULTIMODAL"
  categoryTag          String
  targetProfile        String   @default("IMAGE_CORE")
  description          String
  vramRequiredGb       Float    @default(8.0)
  requiredModelsJson   String
  requiredNodesJson    String
  apiGraphTemplateJson String
  inputSchemaJson      String
  isSeeded             Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([userId, slug])
  @@index([userId, modality, targetProfile])
}

model WorkspaceSettings {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultDashboard       String   @default("vms") // "vms" | "studio"
  gdriveBaseFolder       String   @default("NovelVisualizer/ComfyUI_Storage")
  autoBackupToDrive      Boolean  @default(true)
  diskCleanupThresholdGb Float    @default(6.0)
  idleTimeoutMinutes     Int      @default(15)
  defaultWorkerProfile   String   @default("BASE_COMFY")
  autoVaeFixSdxl         Boolean  @default(true)
  preferredLlmProvider   String   @default("gemini")
  preferredLlmModel      String   @default("gemini-2.5-flash")
  agentMode              String   @default("COPILOT") // "COPILOT" | "AUTONOMOUS"
  systemInstructions     String   @default("")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model AgentSession {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String         @default("Studio Session")
  mode      String         @default("COPILOT") // "COPILOT" | "AUTONOMOUS"
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  messages  AgentMessage[]

  @@index([userId, updatedAt])
}

model AgentMessage {
  id                 String       @id @default(cuid())
  sessionId          String
  session            AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role               String       // "user" | "assistant" | "tool"
  content            String
  toolCallsJson      String?
  proposedActionJson String?
  createdAt          DateTime     @default(now())

  @@index([sessionId, createdAt])
}

model ApiToken {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  tokenPrefix   String
  tokenHash     String    @unique
  scopes        String    @default("ingest,batch,read")
  webhookSecret String?
  lastUsedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@index([userId])
}

model BatchJob {
  id             String      @id @default(cuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  sourceApp      String      @default("studio")
  idempotencyKey String?
  webhookUrl     String?
  rawPayloadJson String?
  strategyJson   String?
  status         String      @default("QUEUED") // QUEUED, RUNNING, COMPLETED, PARTIAL, FAILED
  totalTasks     Int         @default(0)
  completedTasks Int         @default(0)
  failedTasks    Int         @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  tasks          BatchTask[]

  @@unique([userId, idempotencyKey])
  @@index([userId, status, createdAt])
}

model BatchTask {
  id                   String   @id @default(cuid())
  batchId              String
  batch                BatchJob @relation(fields: [batchId], references: [id], onDelete: Cascade)
  sequenceIndex        Int      @default(0)
  sceneKey             String
  trackType            String   @default("VISUAL") // VISUAL, AUDIO_TTS, AUDIO_SFX, AUDIO_BGM, VIDEO_I2V, LIPSYNC
  dependsOnTaskIdsJson String?
  workerProfile        String   @default("IMAGE_CORE")
  baseCheckpoint       String   @default("")
  requiredModelsJson   String?
  workflowSlug         String?
  inputParamsJson      String?
  compiledGraphJson    String?
  assignedTarget       String?
  jobId                String?
  status               String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED, BLOCKED
  outputFilesJson      String?
  errorMessage         String?
  attempts             Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([batchId, sequenceIndex])
  @@index([status])
}

model Project {
  id          String             @id @default(cuid())
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String             @default("")
  stylePreset String             @default("Illustrious Anime")
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  characters  CharacterProfile[]
  scenes      Scene[]

  @@index([userId, updatedAt])
}

model CharacterProfile {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name         String
  triggerWords String   @default("")
  loraSlug     String?
  voicePreset  String   @default("af_heart")
  refImageUrl  String?
  refAudioUrl  String?
  notes        String   @default("")
  createdAt    DateTime @default(now())

  @@index([projectId])
}

model Scene {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  orderIndex Int      @default(0)
  title      String
  narration  String   @default("")
  tracksJson String   @default("{}")
  status     String   @default("DRAFT")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([projectId, orderIndex])
}
