            "minLength": 1,
            "title": "Openapi Version",
            "type": "string"
          },
          "schema_version": {
            "minLength": 1,
            "title": "Schema Version",
            "type": "string"
          },
          "trace_id": {
            "minLength": 1,
            "title": "Trace Id",
            "type": "string"
          }
        },
        "required": [
          "contract_hash",
          "schema_version",
          "openapi_version",
          "trace_id",
          "limits"
        ],
        "title": "ContractManifestResponse",
        "type": "object"
      },
      "DependencyHealth": {
