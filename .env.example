# =================================================================
# Scriptoria - Cloud GPU VM Orchestrator Configuration Template
# =================================================================
# Copy this file to .env and fill in your personal credentials.
# NEVER commit your actual .env file to public version control.

# --- Server & Dashboard Settings ---
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000

# --- Kaggle Multi-Account Credentials ---
# Account 1 (Primary - e.g. 2x T4 GPUs on ports 8188 & 8189)
KAGGLE_ACC1_USERNAME=your_kaggle_acc1_username
KAGGLE_ACC1_KEY=your_kaggle_acc1_api_key_or_token

# Account 2 (Secondary - e.g. 2x T4 GPUs on ports 8190 & 8191)
KAGGLE_ACC2_USERNAME=your_kaggle_acc2_username
KAGGLE_ACC2_KEY=your_kaggle_acc2_legacy_api_key

# Default active fallback credentials
KAGGLE_USERNAME=your_kaggle_acc1_username
KAGGLE_KEY=your_kaggle_acc1_api_key

# --- Google Drive RCLONE RC Streaming Credentials ---
# OAuth Client ID & Secret from Google Cloud Console
GDRIVE_CLIENT_ID=your_gdrive_oauth_client_id.apps.googleusercontent.com
GDRIVE_CLIENT_SECRET=your_gdrive_oauth_client_secret
GDRIVE_REFRESH_TOKEN=your_gdrive_oauth_refresh_token

# --- Cloudflare Named Tunnel Tokens ---
# Tunnel token for Kaggle Dual-GPU instances (routes gpu0..gpu3)
CF_TOKEN_KAGGLE=your_cloudflare_tunnel_token_for_kaggle

# Tunnel token for Google Colab instances (routes gcgpu..gcgpu5)
CF_TOKEN_GCGPU=your_cloudflare_tunnel_token_for_colab

# --- GPU Public Ingress Endpoints ---
COMFYUI_GPU0_URL=https://gpu0.yourdomain.com
COMFYUI_GPU1_URL=https://gpu1.yourdomain.com
COMFYUI_GPU2_URL=https://gpu2.yourdomain.com
COMFYUI_GPU3_URL=https://gpu3.yourdomain.com
COMFYUI_GCGPU_URL=https://gcgpu.yourdomain.com
COMFYUI_GCGPU1_URL=https://gcgpu1.yourdomain.com

