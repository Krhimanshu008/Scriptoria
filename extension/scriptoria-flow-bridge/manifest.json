{
  "manifest_version": 3,
  "name": "Scriptoria — Google AI Flow Companion Bridge",
  "short_name": "ScriptoriaFlow",
  "version": "1.0.0",
  "description": "Zero-ban browser companion connecting Google AI Flow (Nano Banana, Imagen 3, Veo) to Scriptoria via local WebSocket.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Scriptoria Flow Companion",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://flow.google/*",
    "https://*.flow.google/*",
    "https://flow.google.com/*",
    "https://*.flow.google.com/*",
    "https://flow-content.google/*",
    "https://*.flow-content.google/*",
    "https://aistudio.google.com/*",
    "https://*.aistudio.google.com/*",
    "https://labs.google/*",
    "https://*.googleusercontent.com/*",
    "https://scriptoria.krhimanshu.in/*",
    "wss://scriptoria.krhimanshu.in/*",
    "http://127.0.0.1:8000/*",
    "ws://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "ws://localhost:8000/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://flow.google/*",
        "https://*.flow.google/*",
        "https://flow.google.com/*",
        "https://*.flow.google.com/*",
        "https://labs.google/*"
      ],
      "js": [
        "config.js",
        "flow_deck_controller.js",
        "flow_character_sync.js",
        "flow_scene_sync.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://aistudio.google.com/*",
        "https://*.aistudio.google.com/*"
      ],
      "js": [
        "config.js",
        "aistudio_companion.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "injected.js",
        "flow_deck_controller.js",
        "flow_character_sync.js",
        "flow_scene_sync.js"
      ],
      "matches": [
        "https://flow.google/*",
        "https://*.flow.google/*",
        "https://flow.google.com/*",
        "https://*.flow.google.com/*",
        "https://labs.google/*"
      ]
    }
  ]
}
